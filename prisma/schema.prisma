generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          Int             @id @default(autoincrement())
  slug        String          @unique
  title       String
  description String
  imageSrc    String
  category    ProjectCategory
  content     String
  gallery     String[]        @default([])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  rotaryYear  String
}

model Member {
  id         Int      @id @default(autoincrement())
  name       String
  bio        String?
  occupation String
  imageSrc   String
  division   Division
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  role       Role     @default(MEMBER)
}

enum ProjectCategory {
  COMMUNITY_SERVICE
  PROFESSIONAL_DEVELOPMENT
  INTERNATIONAL_UNDERSTANDING
  CLUB_SERVICE
  FINANCE
  PUBLIC_IMAGE
}

enum Division {
  BOARD
  DIRECTORS
  MEMBERS
  GUESTS
}

enum Role {
  PRESIDENT
  VICE_PRESIDENT
  SECRETARY
  TREASURER
  SERGEANT_AT_ARMS
  IMMEDIATE_PAST_PRESIDENT
  ADVISOR
  COMMUNITY_SERVICE_DIRECTOR
  FINANCE_DIRECTOR
  INTERNATIONAL_UNDERSTANDING_DIRECTOR
  PROFESSIONAL_DEVELOPMENT_DIRECTOR
  CLUB_SERVICE_DIRECTOR
  PUBLIC_IMAGE_DIRECTOR
  MEMBER
  GUEST
}
